LLM_PROVIDER=openai
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,poolside/laguna-s-2.1:free
LLM_API_KEY=replace-with-openrouter-key
LLM_BASE_URL=https://openrouter.ai/api/v1
CALL_QUALITY_LLM_ENABLED=true
CALL_QUALITY_DIARIZATION_ENABLED=false
CALL_QUALITY_WHISPER_MODEL=base
CALL_QUALITY_CPU_THREADS=6
CALL_QUALITY_LLM_MIN_INTERVAL_SECONDS=10
CALL_QUALITY_LLM_RETRY_BACKOFF_SECONDS=15
CALL_QUALITY_LLM_REQUEST_TIMEOUT_SECONDS=600
CALL_QUALITY_LLM_MAX_RETRIES=5
